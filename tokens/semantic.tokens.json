{
  "$description": "Semantic tokens. These are what components and styles use. Values here are for the light scheme; see schemes/dark.tokens.json for dark overrides.",
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": "{color.base.950}" },
      "secondary": { "$value": "{color.base.600}" },
      "code": { "$value": "{color.base.950}" }
    },
    "surface": {
      "page": { "$value": "{color.base.50}" },
      "card": { "$value": "{color.base.100}" },
      "code": { "$value": "{color.base.100}" },
      "card": { "$value": "{color.base.100}" }
    },
    "border": {
      "subtle": { "$value": "{color.base.200}" },
      "default": { "$value": "{color.base.600}" }
    },
    "accent": { "$value": "{color.brand.orange}" },
    "highlight": { "$value": "{color.brand.yellow}" },
    "highlight-wash": { "$value": "{color.brand.yellow-wash}" },
    "syntax": {
      "text": { "$value": "{color.base.800}" },
      "string": { "$value": "{color.syntax.green}" },
      "function": { "$value": "{color.syntax.red}" },
      "keyword": { "$value": "{color.syntax.purple}" },
      "class": { "$value": "{color.syntax.orange}" },
      "operator": { "$value": "{color.syntax.cyan}" },
      "comment": { "$value": "{color.base.400}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": "{font.family.tiempos-text}" },
      "heading": { "$value": "{font.family.tiempos-headline}" },
      "ui": { "$value": "{font.family.zalando-sans}" },
      "mono": { "$value": "{font.family.jetbrains-mono}" }
    },
    "weight": { "$type": "fontWeight", "heading": { "$value": 400 } },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.6 },
      "heading": { "$value": 1.15 }
    },
    "width": {
      "$type": "number",
      "ui": {
        "$description": "Running sans text: captions, footnotes, tables.",
        "$value": "{font.width.narrow}"
      },
      "label": {
        "$description": "Short sans text: subheadings, nav.",
        "$value": "{font.width.normal}"
      },
      "display": {
        "$description": "Display sans: card titles and other large, short text.",
        "$value": "{font.width.expanded}"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": "{scale.xxs}" },
    "xs": { "$value": "{scale.xs}" },
    "s": { "$value": "{scale.s}" },
    "m": { "$value": "{scale.m}" },
    "l": { "$value": "{scale.l}" },
    "xl": { "$value": "{scale.xl}" },
    "xxl": { "$value": "{scale.xxl}" }
  },
  "size": {
    "$type": "dimension",
    "container": { "$value": { "value": 33, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "pill": { "$value": { "value": 999, "unit": "px" } }
  }
}
