{
  "$description": "Dark scheme overrides. Only colours belong here; they’re emitted as light-dark() pairs.",
  "color": {
    "$type": "color",
    "text": {
      "primary": {"$value": "{color.base.50}"},
      "secondary": {"$value": "{color.base.200}"},
      "code": {"$value": "{color.base.100}"}
    },
    "surface": {
      "page": {"$value": "{color.base.950}"},
      "code": {"$value": "{color.base.800}"},
      "card": {"$value": "{color.base.900}"}
    },
    "border": {
      "subtle": {"$value": "{color.base.800}"},
      "default": {"$value": "{color.base.200}"}
    },
    "syntax": {
      "text": {"$value": "{color.base.100}"},
      "function": {"$value": "{color.syntax.red-light}"},
      "keyword": {"$value": "{color.syntax.purple-light}"},
      "comment": {"$value": "{color.base.600}"}
    }
  }
}
